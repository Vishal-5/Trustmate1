# TRUSTMATE Agent App Environment Configuration (Person B)

# 1. TRUSTMATE MCP Server URL (Person A's server)
# Default to local mock server on port 8001; switch to live server URL when Person A deploys
TRUST_MCP_URL=http://127.0.0.1:8001

# 2. PayPal Sandbox Credentials
# Set these when testing with live PayPal Sandbox Developer accounts
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox

# 3. PayPal MCP Server (Optional, if using PayPal MCP JSON-RPC service)
# PAYPAL_MCP_URL=http://localhost:8002/mcp

# 4. App Server Configuration
PORT=8000
HOST=127.0.0.1

